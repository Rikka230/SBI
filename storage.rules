rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /* ============================================================
       HELPERS
       ============================================================ */

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function hasUserDoc() {
      return signedIn() && firestore.exists(userDocPath(request.auth.uid));
    }

    function currentUser() {
      return firestore.get(userDocPath(request.auth.uid)).data;
    }

    function isActiveUser() {
      return hasUserDoc()
        && currentUser().statut != 'suspendu';
    }

    function isAdmin() {
      return isActiveUser()
        && (
          currentUser().isGod == true ||
          currentUser().role == 'admin'
        );
    }

    function canReadStudentDocument(studentId) {
      return isAdmin() || (isActiveUser() && request.auth.uid == studentId);
    }

    function canManageStudentDocument(studentId) {
      return isAdmin();
    }

    function canStudentUploadOwnDocument(studentId) {
      return isActiveUser() && request.auth.uid == studentId;
    }

    function validStudentDocumentUpload(studentId, documentId) {
      return (isAdmin() || canStudentUploadOwnDocument(studentId))
        && request.resource.size < 40 * 1024 * 1024
        && request.resource.metadata.keys().hasAny(['uploadedBy'])
        && request.resource.metadata.keys().hasAny(['studentUid'])
        && request.resource.metadata.keys().hasAny(['documentId'])
        && request.resource.metadata.uploadedBy == request.auth.uid
        && request.resource.metadata.studentUid == studentId
        && request.resource.metadata.documentId == documentId
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
          request.resource.contentType == 'text/plain'
        );
    }

    function canManageAvatar(userId) {
      return isActiveUser()
        && (
          request.auth.uid == userId ||
          isAdmin()
        );
    }

    function courseDocPath(courseId) {
      return /databases/(default)/documents/courses/$(courseId);
    }

    function courseDocExists(courseId) {
      return courseId is string
        && firestore.exists(courseDocPath(courseId));
    }

    function canManageCourseMedia(courseId) {
      return isAdmin()
        || (
          isActiveUser()
          && courseDocExists(courseId)
          && firestore.get(courseDocPath(courseId)).data.auteurId == request.auth.uid
        );
    }

    function formationPath(formationId) {
      return /databases/(default)/documents/formations/$(formationId);
    }

    function currentUserHasFormationIds() {
      return currentUser().keys().hasAny(['formationIds'])
        && currentUser().formationIds is list
        && currentUser().formationIds.size() > 0;
    }

    function currentUserHasFormationsAcces() {
      return currentUser().keys().hasAny(['formationsAcces'])
        && currentUser().formationsAcces is list
        && currentUser().formationsAcces.size() > 0;
    }

    function courseHasFormations(courseData) {
      return courseData.keys().hasAny(['formations'])
        && courseData.formations is list
        && courseData.formations.size() > 0;
    }

    function courseHasTargetFormationIds(courseData) {
      return courseData.keys().hasAny(['targetFormationIds'])
        && courseData.targetFormationIds is list
        && courseData.targetFormationIds.size() > 0;
    }

    function courseHasTargetFormationTitles(courseData) {
      return courseData.keys().hasAny(['targetFormationTitles'])
        && courseData.targetFormationTitles is list
        && courseData.targetFormationTitles.size() > 0;
    }

    function courseSharedByFormationsField(courseData) {
      return courseHasFormations(courseData)
        && (
          (
            currentUserHasFormationIds()
            && courseData.formations.hasAny(currentUser().formationIds)
          )
          || (
            currentUserHasFormationsAcces()
            && courseData.formations.hasAny(currentUser().formationsAcces)
          )
        );
    }

    function courseSharedByTargetFormationIds(courseData) {
      return courseHasTargetFormationIds(courseData)
        && currentUserHasFormationIds()
        && courseData.targetFormationIds.hasAny(currentUser().formationIds);
    }

    function courseSharedByTargetFormationTitles(courseData) {
      return courseHasTargetFormationTitles(courseData)
        && currentUserHasFormationsAcces()
        && courseData.targetFormationTitles.hasAny(currentUser().formationsAcces);
    }

    function courseSharedWithCurrentUser(courseData) {
      return courseSharedByFormationsField(courseData)
        || courseSharedByTargetFormationIds(courseData)
        || courseSharedByTargetFormationTitles(courseData);
    }

    function courseTargetedToCurrentUser(courseData) {
      return courseData.keys().hasAny(['targetStudents'])
        && courseData.targetStudents is list
        && request.auth.uid in courseData.targetStudents;
    }

    function formationDocHasCurrentUser(formationId) {
      return signedIn()
        && formationId is string
        && firestore.exists(formationPath(formationId))
        && (
          (
            firestore.get(formationPath(formationId)).data.keys().hasAny(['students'])
            && firestore.get(formationPath(formationId)).data.students is list
            && request.auth.uid in firestore.get(formationPath(formationId)).data.students
          )
          || (
            firestore.get(formationPath(formationId)).data.keys().hasAny(['profs'])
            && firestore.get(formationPath(formationId)).data.profs is list
            && request.auth.uid in firestore.get(formationPath(formationId)).data.profs
          )
        );
    }

    function courseFormationAtAllowsCurrentUser(courseData, index) {
      return courseHasFormations(courseData)
        && courseData.formations.size() > index
        && formationDocHasCurrentUser(courseData.formations[index]);
    }

    function courseLinkedToReadableFormation(courseData) {
      return courseFormationAtAllowsCurrentUser(courseData, 0)
        || courseFormationAtAllowsCurrentUser(courseData, 1)
        || courseFormationAtAllowsCurrentUser(courseData, 2)
        || courseFormationAtAllowsCurrentUser(courseData, 3)
        || courseFormationAtAllowsCurrentUser(courseData, 4);
    }

    function canReadCourseMedia(courseId) {
      return isAdmin()
        || (
          isActiveUser()
          && courseDocExists(courseId)
          && (
            firestore.get(courseDocPath(courseId)).data.auteurId == request.auth.uid
            || (
              firestore.get(courseDocPath(courseId)).data.actif == true
              && (
                courseSharedWithCurrentUser(firestore.get(courseDocPath(courseId)).data)
                || courseTargetedToCurrentUser(firestore.get(courseDocPath(courseId)).data)
                || courseLinkedToReadableFormation(firestore.get(courseDocPath(courseId)).data)
              )
            )
          )
        );
    }

    function validCourseMediaUpload() {
      return isActiveUser()
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.metadata.keys().hasAny(['uploadedBy'])
        && request.resource.metadata.keys().hasAny(['uploadedBy'])
        && request.resource.metadata.uploadedBy == request.auth.uid
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*')
        );
    }

    /* ============================================================
       MÉDIAS PUBLICS INDEX / LANDING
       ============================================================
       Chemin utilisé par SBI 6.5 :
       site/index/**

       Lecture : publique, pour affichage de l'index sans connexion.
       Upload : admin/isGod uniquement, image/vidéo, max 250 Mo.
       ============================================================ */
    match /site/index/{allPaths=**} {
      allow read: if true;

      allow create, update: if isAdmin()
        && request.resource.size < 250 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*')
        );

      allow delete: if isAdmin();
    }



    /* ============================================================
       MÉDIAS PUBLICS FORMATIONS / RESSOURCES
       ============================================================ */
    match /site/formations/{formationId}/cover/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /site/resources/{resourceId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 60 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
      allow delete: if isAdmin();
    }

    /* ============================================================
       MÉDIAS DES COURS
       ============================================================
       Chemin utilisé par le site :
       courses/{courseId}/chapters/{chapterId}/{fileName}

       Lecture : limitée aux admins, auteurs et utilisateurs autorisés
       par les formations / ciblages du cours.
       Upload : utilisateur actif avec métadonnée uploadedBy cohérente,
       image/vidéo, max 200 Mo.
       Suppression : admin ou auteur du cours.
       ============================================================ */
    match /courses/{courseId}/chapters/{chapterId}/{fileName} {
      allow read: if canReadCourseMedia(courseId);

      allow create: if validCourseMediaUpload();

      allow update: if canManageCourseMedia(courseId)
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.metadata.uploadedBy == request.auth.uid
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*')
        );

      allow delete: if canManageCourseMedia(courseId);
    }

    /* ============================================================
       AVATARS UTILISATEURS
       ============================================================
       Chemin utilisé par SBI 5.4 :
       users/{userId}/avatar/{fileName}

       - chaque utilisateur peut gérer son avatar
       - admin/isGod peut gérer l'avatar d'un autre utilisateur
         pour la migration automatique des anciens avatars base64
       ============================================================ */
    match /users/{userId}/avatar/{fileName} {
      allow read: if isActiveUser();

      allow create, update: if canManageAvatar(userId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if canManageAvatar(userId);
    }

    /* ============================================================
       DOCUMENTS ÉLÈVES — COFFRE ADMIN
       ============================================================
       Chemin utilisé par SBI 8.0P.167.68+ :
       student-documents/{studentId}/{documentId}/{fileName}

       V1 : lecture et écriture admin uniquement. L'ouverture élève sera
       étudiée dans une étape dédiée après validation des catégories/droits.
       ============================================================ */
    match /student-documents/{studentId}/{documentId}/{fileName} {
      allow read: if canReadStudentDocument(studentId);

      allow create: if validStudentDocumentUpload(studentId, documentId);

      allow update: if canManageStudentDocument(studentId)
        && validStudentDocumentUpload(studentId, documentId);

      allow delete: if canManageStudentDocument(studentId);
    }

    /* ============================================================
       SÉCURITÉ PAR DÉFAUT
       ============================================================ */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
