rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       HELPERS
       ============================================================ */

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function formationPath(formationId) {
      return /databases/$(database)/documents/formations/$(formationId);
    }

    function promotionPath(promotionId) {
      return /databases/$(database)/documents/promotions/$(promotionId);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActiveUser() {
      return hasUserDoc()
        && currentUser().statut != 'suspendu';
    }

    function hasAnyRole(roles) {
      return isActiveUser()
        && currentUser().keys().hasAny(['role'])
        && currentUser().role in roles;
    }

    function isGod() {
      return isActiveUser()
        && currentUser().isGod == true;
    }

    function isAdmin() {
      return isActiveUser()
        && (
          currentUser().isGod == true ||
          currentUser().role == 'admin'
        );
    }

    function isTeacher() {
      return hasAnyRole(['teacher', 'prof', 'professeur', 'enseignant']);
    }

    function isStudent() {
      return hasAnyRole(['student', 'eleve', 'élève', 'etudiant', 'étudiant']);
    }

    // SBI 8.0P.167.287 — rôle « tuteur » / maître d'apprentissage.
    function isTutor() {
      return hasAnyRole(['tutor', 'tuteur', 'mentor']);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function changedOnly(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function userProtectedFields() {
      return [
        'email',
        'emailUpdatedAt',
        'emailUpdatedBy',
        'prenom',
        'nom',
        'role',
        'isGod',
        'statut',
        'dateCreation',
        'createdAt',
        'createdBy',
        'updatedBy',
        'formationIds',
        'formationsAcces',
        'formationIndexSyncedAt',
        'formationIndexSyncedBy'
      ];
    }

    function ownUserWritableFields() {
      return [
        'bio',
        'privateData',
        'photoURL',
        'photoOriginal',
        'photoStoragePath',
        'avatarUpdatedAt',
        'avatarStorageVersion',
        'avatarCleanupAt',
        'isOnline',
        'lastSeenAt',
        'totalConnectionTime',
        'learningProgress',
        'xp',
        'updatedAt'
      ];
    }

    function adminUserMaintenanceWritableFields() {
      return [
        'bio',
        'privateData',
        'photoURL',
        'photoOriginal',
        'photoStoragePath',
        'avatarUpdatedAt',
        'avatarStorageVersion',
        'avatarCleanupAt',
        'learningProgress',
        'xp',
        'updatedAt'
      ];
    }

    function safeOwnUserUpdate(userId) {
      return isSelf(userId)
        && changedOnly(ownUserWritableFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(userProtectedFields());
    }

    function safeAdminUserMaintenanceUpdate(userId) {
      return isAdmin()
        && !isSelf(userId)
        && changedOnly(adminUserMaintenanceWritableFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(userProtectedFields());
    }

    function currentUserHasFormationIds() {
      return currentUser().keys().hasAny(['formationIds'])
        && currentUser().formationIds is list
        && currentUser().formationIds.size() > 0;
    }

    function currentUserHasFormationsAcces() {
      return currentUser().keys().hasAny(['formationsAcces'])
        && currentUser().formationsAcces is list
        && currentUser().formationsAcces.size() > 0;
    }

    function currentUserHasPromotionId() {
      return currentUser().keys().hasAny(['promotionId'])
        && currentUser().promotionId is string
        && currentUser().promotionId != '';
    }

    function currentUserHasCurrentPromotionId() {
      return currentUser().keys().hasAny(['currentPromotionId'])
        && currentUser().currentPromotionId is string
        && currentUser().currentPromotionId != '';
    }

    function currentUserHasCohortId() {
      return currentUser().keys().hasAny(['cohortId'])
        && currentUser().cohortId is string
        && currentUser().cohortId != '';
    }

    function currentUserPromotionIdMatches(promotionId) {
      return isActiveUser()
        && promotionId is string
        && promotionId != ''
        && (
          (currentUserHasPromotionId() && currentUser().promotionId == promotionId)
          || (currentUserHasCurrentPromotionId() && currentUser().currentPromotionId == promotionId)
          || (currentUserHasCohortId() && currentUser().cohortId == promotionId)
          || (
            currentUser().keys().hasAny(['promotionIds'])
            && currentUser().promotionIds is list
            && promotionId in currentUser().promotionIds
          )
        );
    }

    function userDataHasFormationIds(userData) {
      return userData.keys().hasAny(['formationIds'])
        && userData.formationIds is list
        && userData.formationIds.size() > 0;
    }

    function userDataHasFormationsAcces(userData) {
      return userData.keys().hasAny(['formationsAcces'])
        && userData.formationsAcces is list
        && userData.formationsAcces.size() > 0;
    }

    function sharedFormationWithCurrentUser(userData) {
      return (
          currentUserHasFormationIds()
          && userDataHasFormationIds(userData)
          && userData.formationIds.hasAny(currentUser().formationIds)
        )
        || (
          currentUserHasFormationsAcces()
          && userDataHasFormationsAcces(userData)
          && userData.formationsAcces.hasAny(currentUser().formationsAcces)
        );
    }

    function isAdminProfile(userData) {
      return userData.isGod == true
        || userData.role == 'admin';
    }

    function canReadUser(userId, userData) {
      return isAdmin()
        || isSelf(userId)
        || (
          isTeacher()
          && !isAdminProfile(userData)
          && sharedFormationWithCurrentUser(userData)
        );
    }

    function courseHasFormations(courseData) {
      return courseData.keys().hasAny(['formations'])
        && courseData.formations is list
        && courseData.formations.size() > 0;
    }

    function courseHasFormationIds(courseData) {
      return courseData.keys().hasAny(['formationIds'])
        && courseData.formationIds is list
        && courseData.formationIds.size() > 0;
    }

    function courseHasTargetFormationIds(courseData) {
      return courseData.keys().hasAny(['targetFormationIds'])
        && courseData.targetFormationIds is list
        && courseData.targetFormationIds.size() > 0;
    }

    function courseHasTargetFormationTitles(courseData) {
      return courseData.keys().hasAny(['targetFormationTitles'])
        && courseData.targetFormationTitles is list
        && courseData.targetFormationTitles.size() > 0;
    }

    function courseSharedByFormationsField(courseData) {
      return courseHasFormations(courseData)
        && (
          (
            currentUserHasFormationIds()
            && courseData.formations.hasAny(currentUser().formationIds)
          )
          || (
            currentUserHasFormationsAcces()
            && courseData.formations.hasAny(currentUser().formationsAcces)
          )
        );
    }

    function courseSharedByFormationIds(courseData) {
      return courseHasFormationIds(courseData)
        && currentUserHasFormationIds()
        && courseData.formationIds.hasAny(currentUser().formationIds);
    }

    function courseSharedByTargetFormationIds(courseData) {
      return courseHasTargetFormationIds(courseData)
        && currentUserHasFormationIds()
        && courseData.targetFormationIds.hasAny(currentUser().formationIds);
    }

    function courseSharedByTargetFormationTitles(courseData) {
      return courseHasTargetFormationTitles(courseData)
        && currentUserHasFormationsAcces()
        && courseData.targetFormationTitles.hasAny(currentUser().formationsAcces);
    }

    function courseSharedWithCurrentUser(courseData) {
      return courseSharedByFormationsField(courseData)
        || courseSharedByFormationIds(courseData)
        || courseSharedByTargetFormationIds(courseData)
        || courseSharedByTargetFormationTitles(courseData);
    }

    function courseTargetedToCurrentUser(courseData) {
      return courseData.keys().hasAny(['targetStudents'])
        && courseData.targetStudents is list
        && request.auth.uid in courseData.targetStudents;
    }


    function courseIsPublishedForStudents(courseData) {
      return (
          courseData.keys().hasAny(['actif'])
          && courseData.actif == true
        )
        || (
          courseData.keys().hasAny(['statutValidation'])
          && courseData.statutValidation == 'approved'
          && (
            !courseData.keys().hasAny(['actif'])
            || courseData.actif != false
          )
        );
    }

    function courseTargetsCurrentUserPromotion(courseData) {
      return courseData.keys().hasAny(['targetPromotionIds'])
        && courseData.targetPromotionIds is list
        && (
          (currentUserHasPromotionId() && currentUser().promotionId in courseData.targetPromotionIds)
          || (currentUserHasCurrentPromotionId() && currentUser().currentPromotionId in courseData.targetPromotionIds)
          || (currentUserHasCohortId() && currentUser().cohortId in courseData.targetPromotionIds)
          || (
            currentUser().keys().hasAny(['promotionIds'])
            && currentUser().promotionIds is list
            && courseData.targetPromotionIds.hasAny(currentUser().promotionIds)
          )
        );
    }

    function promotionPlanCourseIdAt(plan, courseId, index) {
      return plan.size() > index
        && (
          (plan[index].keys().hasAny(['courseId']) && plan[index].courseId == courseId)
          || (plan[index].keys().hasAny(['courseID']) && plan[index].courseID == courseId)
          || (plan[index].keys().hasAny(['courseDocId']) && plan[index].courseDocId == courseId)
          || (plan[index].keys().hasAny(['courseRef']) && plan[index].courseRef == courseId)
          || (plan[index].keys().hasAny(['id']) && plan[index].id == courseId)
        );
    }

    function promotionPlanHasCourseId(plan, courseId) {
      return plan is list
        && (
          promotionPlanCourseIdAt(plan, courseId, 0)
          || promotionPlanCourseIdAt(plan, courseId, 1)
          || promotionPlanCourseIdAt(plan, courseId, 2)
          || promotionPlanCourseIdAt(plan, courseId, 3)
          || promotionPlanCourseIdAt(plan, courseId, 4)
          || promotionPlanCourseIdAt(plan, courseId, 5)
          || promotionPlanCourseIdAt(plan, courseId, 6)
          || promotionPlanCourseIdAt(plan, courseId, 7)
          || promotionPlanCourseIdAt(plan, courseId, 8)
          || promotionPlanCourseIdAt(plan, courseId, 9)
          || promotionPlanCourseIdAt(plan, courseId, 10)
          || promotionPlanCourseIdAt(plan, courseId, 11)
          || promotionPlanCourseIdAt(plan, courseId, 12)
          || promotionPlanCourseIdAt(plan, courseId, 13)
          || promotionPlanCourseIdAt(plan, courseId, 14)
          || promotionPlanCourseIdAt(plan, courseId, 15)
          || promotionPlanCourseIdAt(plan, courseId, 16)
          || promotionPlanCourseIdAt(plan, courseId, 17)
          || promotionPlanCourseIdAt(plan, courseId, 18)
          || promotionPlanCourseIdAt(plan, courseId, 19)
          || promotionPlanCourseIdAt(plan, courseId, 20)
          || promotionPlanCourseIdAt(plan, courseId, 21)
          || promotionPlanCourseIdAt(plan, courseId, 22)
          || promotionPlanCourseIdAt(plan, courseId, 23)
          || promotionPlanCourseIdAt(plan, courseId, 24)
          || promotionPlanCourseIdAt(plan, courseId, 25)
          || promotionPlanCourseIdAt(plan, courseId, 26)
          || promotionPlanCourseIdAt(plan, courseId, 27)
          || promotionPlanCourseIdAt(plan, courseId, 28)
          || promotionPlanCourseIdAt(plan, courseId, 29)
          || promotionPlanCourseIdAt(plan, courseId, 30)
          || promotionPlanCourseIdAt(plan, courseId, 31)
          || promotionPlanCourseIdAt(plan, courseId, 32)
          || promotionPlanCourseIdAt(plan, courseId, 33)
          || promotionPlanCourseIdAt(plan, courseId, 34)
          || promotionPlanCourseIdAt(plan, courseId, 35)
          || promotionPlanCourseIdAt(plan, courseId, 36)
          || promotionPlanCourseIdAt(plan, courseId, 37)
          || promotionPlanCourseIdAt(plan, courseId, 38)
          || promotionPlanCourseIdAt(plan, courseId, 39)
          || promotionPlanCourseIdAt(plan, courseId, 40)
          || promotionPlanCourseIdAt(plan, courseId, 41)
          || promotionPlanCourseIdAt(plan, courseId, 42)
          || promotionPlanCourseIdAt(plan, courseId, 43)
          || promotionPlanCourseIdAt(plan, courseId, 44)
          || promotionPlanCourseIdAt(plan, courseId, 45)
          || promotionPlanCourseIdAt(plan, courseId, 46)
          || promotionPlanCourseIdAt(plan, courseId, 47)
          || promotionPlanCourseIdAt(plan, courseId, 48)
          || promotionPlanCourseIdAt(plan, courseId, 49)
        );
    }

    function promotionCourseIdsAllowCourse(promotionData, courseId) {
      return promotionData.keys().hasAny(['coursePlanCourseIds'])
        && promotionData.coursePlanCourseIds is list
        && courseId in promotionData.coursePlanCourseIds;
    }

    function promotionDataAllowsCourse(promotionData, courseId) {
      return promotionCourseIdsAllowCourse(promotionData, courseId)
        || (
          promotionData.keys().hasAny(['coursePlan'])
          && promotionPlanHasCourseId(promotionData.coursePlan, courseId)
        );
    }

    function promotionAllowsCourse(promotionId, courseId) {
      return promotionId is string
        && promotionId != ''
        && exists(promotionPath(promotionId))
        && promotionDataAllowsCourse(get(promotionPath(promotionId)).data, courseId);
    }

    function currentUserPromotionIdAtAllowsCourse(courseId, index) {
      return currentUser().keys().hasAny(['promotionIds'])
        && currentUser().promotionIds is list
        && currentUser().promotionIds.size() > index
        && promotionAllowsCourse(currentUser().promotionIds[index], courseId);
    }

    function currentUserPromotionIdsAllowCourse(courseId) {
      return currentUserPromotionIdAtAllowsCourse(courseId, 0)
        || currentUserPromotionIdAtAllowsCourse(courseId, 1)
        || currentUserPromotionIdAtAllowsCourse(courseId, 2)
        || currentUserPromotionIdAtAllowsCourse(courseId, 3)
        || currentUserPromotionIdAtAllowsCourse(courseId, 4)
        || currentUserPromotionIdAtAllowsCourse(courseId, 5)
        || currentUserPromotionIdAtAllowsCourse(courseId, 6)
        || currentUserPromotionIdAtAllowsCourse(courseId, 7)
        || currentUserPromotionIdAtAllowsCourse(courseId, 8)
        || currentUserPromotionIdAtAllowsCourse(courseId, 9);
    }

    function currentUserPromotionAllowsCourse(courseId) {
      return isStudent()
        && courseId is string
        && courseId != ''
        && (
          (currentUserHasPromotionId() && promotionAllowsCourse(currentUser().promotionId, courseId))
          || (currentUserHasCurrentPromotionId() && promotionAllowsCourse(currentUser().currentPromotionId, courseId))
          || (currentUserHasCohortId() && promotionAllowsCourse(currentUser().cohortId, courseId))
          || currentUserPromotionIdsAllowCourse(courseId)
        );
    }

    function courseTargetedToCurrentTeacher(courseData) {
      return isTeacher()
        && courseData.keys().hasAny(['targetTeacherIds'])
        && courseData.targetTeacherIds is list
        && request.auth.uid in courseData.targetTeacherIds;
    }

    function formationDocHasCurrentUser(formationId) {
      return signedIn()
        && formationId is string
        && exists(formationPath(formationId))
        && (
          (
            get(formationPath(formationId)).data.keys().hasAny(['students'])
            && get(formationPath(formationId)).data.students is list
            && request.auth.uid in get(formationPath(formationId)).data.students
          )
          || (
            get(formationPath(formationId)).data.keys().hasAny(['profs'])
            && get(formationPath(formationId)).data.profs is list
            && request.auth.uid in get(formationPath(formationId)).data.profs
          )
        );
    }

    function courseFormationAtAllowsCurrentUser(courseData, index) {
      return courseHasFormations(courseData)
        && courseData.formations.size() > index
        && formationDocHasCurrentUser(courseData.formations[index]);
    }

    function courseLinkedToReadableFormation(courseData) {
      return courseFormationAtAllowsCurrentUser(courseData, 0)
        || courseFormationAtAllowsCurrentUser(courseData, 1)
        || courseFormationAtAllowsCurrentUser(courseData, 2)
        || courseFormationAtAllowsCurrentUser(courseData, 3)
        || courseFormationAtAllowsCurrentUser(courseData, 4);
    }

    function canTeacherReadSharedCourse(courseData) {
      return isTeacher()
        && (
          courseSharedWithCurrentUser(courseData)
          || courseTargetedToCurrentTeacher(courseData)
          || courseLinkedToReadableFormation(courseData)
        );
    }

    function canReadCourse(courseId, courseData) {
      return isAdmin()
        || (
          isTeacher()
          && courseData.auteurId == request.auth.uid
        )
        || canTeacherReadSharedCourse(courseData)
        || (
          isActiveUser()
          && courseData.actif == true
          && (
            courseSharedWithCurrentUser(courseData)
            || courseTargetedToCurrentUser(courseData)
            || courseTargetsCurrentUserPromotion(courseData)
            || courseLinkedToReadableFormation(courseData)
          )
        )
        || currentUserPromotionAllowsCourse(courseId)
        || (isStudent() && courseTargetsCurrentUserPromotion(courseData))
        || (isStudent() && courseIsPublishedForStudents(courseData));
    }

    function validTeacherCourseWrite() {
      return isTeacher()
        && request.resource.data.auteurId == request.auth.uid
        && request.resource.data.actif == false
        && request.resource.data.statutValidation == 'draft';
    }

    function validTeacherCourseUpdate() {
      return isTeacher()
        && resource.data.auteurId == request.auth.uid
        && request.resource.data.auteurId == resource.data.auteurId
        && request.resource.data.actif == false
        && (
          !resource.data.keys().hasAny(['statutValidation'])
          || resource.data.statutValidation in ['draft', 'rejected']
        )
        && request.resource.data.statutValidation == 'draft';
    }

    function currentUserHasFormationId(formationId) {
      return currentUserHasFormationIds()
        && formationId in currentUser().formationIds;
    }

    function currentUserHasFormationAccess(formationTitle) {
      return currentUserHasFormationsAcces()
        && formationTitle is string
        && formationTitle in currentUser().formationsAcces;
    }

    function isFormationStudent(formationData) {
      return formationData.keys().hasAny(['students'])
        && formationData.students is list
        && request.auth.uid in formationData.students;
    }

    function isFormationTeacher(formationData) {
      return formationData.keys().hasAny(['profs'])
        && formationData.profs is list
        && request.auth.uid in formationData.profs;
    }

    function canReadFormation(formationId, formationData) {
      return isAdmin()
        || (
          isActiveUser()
          && (
            isFormationStudent(formationData)
            || isFormationTeacher(formationData)
            || currentUserHasFormationId(formationId)
            || (
              formationData.keys().hasAny(['titre'])
              && currentUserHasFormationAccess(formationData.titre)
            )
          )
        );
    }

    function canReadPromotion(promotionId, promotionData) {
      return isAdmin()
        || (
          isStudent()
          && currentUserPromotionIdMatches(promotionId)
        )
        || (
          isActiveUser()
          && promotionData.keys().hasAny(['formationId'])
          && formationDocHasCurrentUser(promotionData.formationId)
        )
        || (
          isActiveUser()
          && promotionData.keys().hasAny(['formationId'])
          && currentUserHasFormationIds()
          && promotionData.formationId in currentUser().formationIds
        )
        || (
          isTeacher()
          && promotionData.keys().hasAny(['formationName'])
          && currentUserHasFormationAccess(promotionData.formationName)
        );
    }

    function canReadLiveSession(liveData) {
      return isAdmin()
        || (
          isActiveUser()
          && liveData.keys().hasAny(['promotionId'])
          && currentUserPromotionIdMatches(liveData.promotionId)
        )
        || (
          isTeacher()
          && liveData.keys().hasAny(['formationId'])
          && currentUserHasFormationIds()
          && liveData.formationId in currentUser().formationIds
        )
        || (
          isTeacher()
          && liveData.keys().hasAny(['formationName'])
          && currentUserHasFormationsAcces()
          && liveData.formationName in currentUser().formationsAcces
        )
        || (
          isTeacher()
          && liveData.keys().hasAny(['teacherUid'])
          && liveData.teacherUid == request.auth.uid
        );
    }

    function isDirectNotification() {
      return resource.data.keys().hasAny(['destinataireId'])
        && resource.data.destinataireId == request.auth.uid;
    }

    function isTargetStudentNotification() {
      return resource.data.keys().hasAny(['targetStudents'])
        && resource.data.targetStudents is list
        && request.auth.uid in resource.data.targetStudents;
    }

    function isAdminValidationNotification() {
      return isAdmin()
        && resource.data.type == 'course_validation';
    }

    function canReadNotification() {
      return isActiveUser()
        && (
          isAdminValidationNotification() ||
          isDirectNotification() ||
          isTargetStudentNotification()
        );
    }

    // SBI 8.0P.167.280 — Création de notifications = SERVEUR uniquement (Admin SDK).
    // Le client ne crée plus jamais de notification (refonte : toutes les notifs
    // passent par des Cloud Functions). Il ne fait que lire / dismiss / resolve.
    function canCreateNotification() {
      return false;
    }

    function canDismissNotification() {
      return isActiveUser()
        && changedOnly(['dismissedBy'])
        && request.resource.data.dismissedBy is list
        && request.auth.uid in request.resource.data.dismissedBy
        && (
          !resource.data.keys().hasAny(['dismissedBy']) ||
          request.resource.data.dismissedBy.hasAll(resource.data.dismissedBy)
        );
    }

    function canResolveNotification() {
      return isAdmin()
        && changedOnly(['status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.status == 'resolved'
        && request.resource.data.resolvedBy == request.auth.uid;
    }

    function progressBelongsToCurrentUser(progressId, progressData) {
      return isSelf(progressId)
        || (
          progressData.keys().hasAny(['uid'])
          && progressData.uid == request.auth.uid
        )
        || (
          progressData.keys().hasAny(['userId'])
          && progressData.userId == request.auth.uid
        )
        || (
          progressData.keys().hasAny(['studentId'])
          && progressData.studentId == request.auth.uid
        );
    }

    function canReadProgressDoc(progressId, progressData) {
      return isAdmin()
        || (
          isActiveUser()
          && progressBelongsToCurrentUser(progressId, progressData)
        );
    }

    function canWriteProgressDoc(progressId, progressData) {
      return isAdmin()
        || (
          isActiveUser()
          && progressBelongsToCurrentUser(progressId, progressData)
        );
    }

    /* ============================================================
       DEVOIRS & ÉVALUATIONS (8.0P.167.273)
       ------------------------------------------------------------
       assignments         : créés/édités/validés UNIQUEMENT via Cloud
                             Functions (Admin SDK). Lecture par rôle ci-dessous.
       assignmentSubmissions: dépôt élève (création client) ; correction prof
                             via Cloud Function ; lecture par propriétaire / prof
                             de la formation / admin.
       ============================================================ */

    function assignmentReadableByTeacher(data) {
      return isTeacher()
        && (
          (data.keys().hasAny(['createdBy']) && data.createdBy == request.auth.uid)
          || (
            data.keys().hasAny(['formationId'])
            && data.formationId is string
            && (
              formationDocHasCurrentUser(data.formationId)
              || (currentUserHasFormationIds() && data.formationId in currentUser().formationIds)
            )
          )
        );
    }

    function assignmentReadableByStudent(data) {
      return isStudent()
        && data.keys().hasAny(['status'])
        && data.status == 'published'
        && (
          (
            data.keys().hasAny(['promotionId'])
            && data.promotionId is string
            && data.promotionId != ''
            && currentUserPromotionIdMatches(data.promotionId)
          )
          || (
            (!data.keys().hasAny(['promotionId']) || data.promotionId == '')
            && data.keys().hasAny(['formationId'])
            && data.formationId is string
            && (
              formationDocHasCurrentUser(data.formationId)
              || (currentUserHasFormationIds() && data.formationId in currentUser().formationIds)
            )
          )
        );
    }

    function canReadAssignment(data) {
      return isAdmin()
        || assignmentReadableByTeacher(data)
        || assignmentReadableByStudent(data);
    }

    function canReadAssignmentSubmission(data) {
      return isAdmin()
        || (
          isActiveUser()
          && data.keys().hasAny(['studentUid'])
          && data.studentUid == request.auth.uid
        )
        || (
          isTeacher()
          && data.keys().hasAny(['formationId'])
          && data.formationId is string
          && (
            formationDocHasCurrentUser(data.formationId)
            || (currentUserHasFormationIds() && data.formationId in currentUser().formationIds)
          )
        );
    }

    function validStudentSubmissionCreate() {
      return isActiveUser()
        && request.resource.data.keys().hasAll(['assignmentId', 'studentUid', 'formationId', 'status'])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['correction']);
    }

    /* ============================================================
       PUBLIC SITE SETTINGS
       ============================================================ */

    match /settings/siteIndex {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }


    /* ============================================================
       PUBLIC FORMATIONS / RESOURCES
       ============================================================ */

    match /publicFormations/{formationId} {
      allow get, list: if isAdmin()
        || resource.data.status in ['published', 'coming_soon'];
      allow create, update, delete: if isAdmin();
    }

    match /publicResources/{resourceId} {
      allow get, list: if isAdmin()
        || (resource.data.status == 'published'
          && resource.data.globalVisible == true);
      allow create, update, delete: if isAdmin();
    }

    /* ============================================================
       USERS
       ============================================================ */

    match /users/{userId} {
      allow get, list: if canReadUser(userId, resource.data);

      // Création / édition sensible / suppression : uniquement via Cloud Functions Admin SDK.
      allow create: if false;

      allow update: if safeOwnUserUpdate(userId)
        || safeAdminUserMaintenanceUpdate(userId);

      allow delete: if false;
    }

    /* ============================================================
       COURSES
       ============================================================ */

    match /courses/{courseId} {
      // 8.0P.167.153 : passe-droit viewer direct strictement par ID.
      // Important : on ne passe plus par canReadCourse() pour get, car certains anciens
      // documents cours n'ont pas tous les champs attendus et peuvent faire échouer
      // l'évaluation des règles avant d'arriver au garde minimal.
      // Le list reste filtré : pas d'exploration globale de la collection courses.
      // 8.0P.167.248 (audit S1) : isActiveUser() au lieu de signedIn() afin d'exiger
      // un compte avec doc utilisateur et non suspendu. isActiveUser() ne lit pas les
      // champs du document cours, donc aucune régression sur les anciens docs incomplets.
      allow get: if isActiveUser();
      allow list: if canReadCourse(courseId, resource.data);

      allow create: if isAdmin()
        || validTeacherCourseWrite();

      allow update: if isAdmin()
        || validTeacherCourseUpdate();

      allow delete: if isAdmin()
        || (
          isTeacher()
          && resource.data.auteurId == request.auth.uid
          && resource.data.actif == false
          && resource.data.statutValidation == 'draft'
        );
    }

    match /courseBlocks/{blockId} {
      // 8.0P.167.250 (audit 2B) : le get par ID reste ouvert aux comptes actifs, mais le
      // list global (énumération de tout le référentiel) est réservé aux éditeurs
      // (teacher/admin via le course-editor). Les élèves n'énumèrent pas courseBlocks.
      allow get: if isActiveUser();
      allow list: if isAdmin() || isTeacher();
      allow create, update, delete: if isAdmin();
    }

    /* ============================================================
       FORMATIONS
       ============================================================ */

    match /formations/{formationId} {
      allow get, list: if canReadFormation(formationId, resource.data);

      allow create, update, delete: if isAdmin();
    }

    /* ============================================================
       DOCUMENTS DE FORMATION (8.0P.167.282)
       Livret / règlement / planning / référentiel + autres, par formation.
       Lecture : admin OU membre (élève/prof) de la formation. Écriture : admin.
       (Visibilité membre = query where('formationId','in',[mes formations]).)
       ============================================================ */
    match /formationDocuments/{docId} {
      allow get, list: if isAdmin()
        || (
          isActiveUser()
          && resource.data.keys().hasAny(['formationId'])
          && resource.data.formationId is string
          && (
            formationDocHasCurrentUser(resource.data.formationId)
            || (currentUserHasFormationIds() && resource.data.formationId in currentUser().formationIds)
          )
        );

      allow create, update, delete: if isAdmin();
    }

    /* ============================================================
       LIVRET D'APPRENTISSAGE (8.0P.167.287)
       1 livret par élève. Lecture : admin ; élève propriétaire (studentId) ;
       tuteur assigné (tutorId) ; teacher/responsable péda de la promotion/formation.
       Écriture : Cloud Functions UNIQUEMENT (portée par champ + verrou côté serveur).
       ============================================================ */
    match /apprenticeshipBooklets/{bookletId} {
      allow get, list: if isAdmin()
        || (isActiveUser() && resource.data.keys().hasAny(['studentId']) && resource.data.studentId == request.auth.uid)
        || (isActiveUser() && resource.data.keys().hasAny(['tutorId']) && resource.data.tutorId == request.auth.uid)
        || (
          isTeacher()
          && (
            (resource.data.keys().hasAny(['promotionId']) && currentUserPromotionIdMatches(resource.data.promotionId))
            || (resource.data.keys().hasAny(['formationId']) && formationDocHasCurrentUser(resource.data.formationId))
          )
        );

      allow create, update, delete: if false;
    }

    /* ============================================================
       PROMOTIONS
       ============================================================ */

    match /promotions/{promotionId} {
      allow get, list: if canReadPromotion(promotionId, resource.data);
      allow create, update, delete: if isAdmin();
    }

    /* ============================================================
       LIVE SESSIONS
       ============================================================ */

    match /liveSessions/{liveId} {
      allow get, list: if canReadLiveSession(resource.data);
      allow create, update, delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if canReadLiveSession(get(/databases/$(database)/documents/liveSessions/$(liveId)).data);
        allow create: if isActiveUser()
          && canReadLiveSession(get(/databases/$(database)/documents/liveSessions/$(liveId)).data)
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /files/{fileId} {
        allow get, list: if canReadLiveSession(get(/databases/$(database)/documents/liveSessions/$(liveId)).data);
        allow create: if (isTeacher() || isAdmin())
          && canReadLiveSession(get(/databases/$(database)/documents/liveSessions/$(liveId)).data)
          && request.resource.data.uploadedBy == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /attendance/{attendanceId} {
        allow get, list: if canReadLiveSession(get(/databases/$(database)/documents/liveSessions/$(liveId)).data);
        // 8.0P.167.250 (audit 2B) : l'attendance n'est écrite que côté serveur (Cloud
        // Functions via admin SDK, qui contourne ces règles). On interdit l'écriture
        // cliente directe pour empêcher toute falsification de présence/durée.
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    /* ============================================================
       CURRICULUM TEMPLATES
       ============================================================ */

    match /curriculumTemplates/{curriculumId} {
      // 8.0P.167.290 — Lecture unitaire ouverte aux utilisateurs actifs : un planning
      // « Documents de formation » généré depuis un cursus doit pouvoir s'hydrater
      // côté élève / prof / tuteur (getDoc du template). Les templates ne sont pas
      // confidentiels (structure de cursus). La liste reste réservée à l'admin.
      allow get: if isActiveUser() || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /* ============================================================
       NOTIFICATIONS
       ============================================================ */

    match /notifications/{notificationId} {
      allow get: if canReadNotification();
      allow list: if canReadNotification();

      allow create: if canCreateNotification();

      allow update: if canDismissNotification()
        || canResolveNotification();

      allow delete: if isAdmin();
    }

    /* ============================================================
       TEACHER COURSE ACCESS INDEX
       ============================================================ */

    match /teacherCourseAccess/{teacherId} {
      allow get, list: if isAdmin()
        || (isTeacher() && request.auth.uid == teacherId);

      allow create, update, delete: if isAdmin();

      match /courses/{courseAccessId} {
        allow get, list: if isAdmin()
          || (isTeacher() && request.auth.uid == teacherId);

        allow create, update, delete: if isAdmin();
      }
    }

    /* ============================================================
       PROGRESS / TRACKING LEGACY COLLECTIONS
       ============================================================ */

    match /progress/{progressId} {
      allow get, list: if canReadProgressDoc(progressId, resource.data);
      allow create: if canWriteProgressDoc(progressId, request.resource.data);
      allow update: if canWriteProgressDoc(progressId, resource.data)
        && canWriteProgressDoc(progressId, request.resource.data);
      allow delete: if isAdmin();
    }

    match /courseProgress/{progressId} {
      allow get, list: if canReadProgressDoc(progressId, resource.data);
      allow create: if canWriteProgressDoc(progressId, request.resource.data);
      allow update: if canWriteProgressDoc(progressId, resource.data)
        && canWriteProgressDoc(progressId, request.resource.data);
      allow delete: if isAdmin();
    }

    match /quizResults/{resultId} {
      allow get, list: if canReadProgressDoc(resultId, resource.data);
      allow create: if canWriteProgressDoc(resultId, request.resource.data);
      allow update: if canWriteProgressDoc(resultId, resource.data)
        && canWriteProgressDoc(resultId, request.resource.data);
      allow delete: if isAdmin();
    }


    /* ============================================================
       STUDENT DOCUMENTS / REQUESTS
       ============================================================ */

    match /studentDocuments/{documentId} {
      allow get, list: if isAdmin()
        || (isActiveUser()
          && resource.data.keys().hasAll(['studentUid', 'visibility', 'status'])
          && resource.data.studentUid == request.auth.uid
          && resource.data.visibility == 'student_visible'
          && resource.data.status in ['active', 'submitted', 'validated']);

      allow create: if isAdmin()
        || (isActiveUser()
          && request.resource.data.keys().hasAny(['studentUid'])
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.keys().hasAny(['source'])
          && request.resource.data.source == 'student_request');

      allow update: if isAdmin()
        || (isActiveUser()
          && resource.data.keys().hasAny(['studentUid'])
          && resource.data.studentUid == request.auth.uid
          && request.resource.data.studentUid == resource.data.studentUid
          // 8.0P.167.248 (audit S2) : l'élève ne peut pas auto-valider son document.
          // 'validated' reste réservé à isAdmin().
          && request.resource.data.status != 'validated'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'filePath', 'fileName', 'status', 'submittedAt', 'uploadedAt', 'updatedAt'
          ]));

      allow delete: if isAdmin();
    }

    match /studentDocumentRequests/{requestId} {
      allow get: if isAdmin()
        || (isActiveUser()
          && resource.data.keys().hasAny(['studentUid'])
          && resource.data.studentUid == request.auth.uid);

      allow list: if isAdmin();

      allow create: if isAdmin();

      allow update: if isAdmin()
        || (isActiveUser()
          && resource.data.keys().hasAny(['studentUid'])
          && resource.data.studentUid == request.auth.uid
          && !(resource.data.keys().hasAny(['status']) && resource.data.status in ['canceled', 'cancelled', 'archived'])
          && request.resource.data.studentUid == resource.data.studentUid
          // 8.0P.167.248 (audit S2) : l'élève ne peut pas marquer sa demande comme validée.
          && request.resource.data.status != 'validated'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'items', 'status', 'submittedAt', 'updatedAt'
          ]));

      allow delete: if isAdmin();
    }

    /* ============================================================
       DEVOIRS & ÉVALUATIONS
       ============================================================ */

    match /assignments/{assignmentId} {
      allow get, list: if canReadAssignment(resource.data);

      // Création / édition / validation / archivage : Cloud Functions (Admin SDK)
      // uniquement, pour garantir le workflow draft → pending_validation → published.
      allow create, update, delete: if false;
    }

    match /assignmentSubmissions/{submissionId} {
      allow get, list: if canReadAssignmentSubmission(resource.data);

      // Dépôt élève : création unique côté client (id = assignmentId_studentUid).
      allow create: if validStudentSubmissionCreate();

      // Verrouillé après dépôt : l'élève ne peut plus modifier/supprimer.
      // Les corrections passent par Cloud Function (Admin SDK).
      allow update, delete: if isAdmin();
    }

    /* ============================================================
       FALLBACK
       ============================================================ */

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
