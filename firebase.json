{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.log",
      "**/*.bat",
      "functions/**"
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/about",
        "destination": "/a-propos.html",
        "type": 301
      },
      {
        "source": "/about/",
        "destination": "/a-propos.html",
        "type": 301
      },
      {
        "source": "/about-3",
        "destination": "/a-propos.html",
        "type": 301
      },
      {
        "source": "/faq",
        "destination": "/ressources.html",
        "type": 301
      },
      {
        "source": "/faq/",
        "destination": "/ressources.html",
        "type": 301
      },
      {
        "source": "/contact-8",
        "destination": "/contact.html",
        "type": 301
      },
      {
        "source": "/book-online",
        "destination": "/formations.html",
        "type": 301
      },
      {
        "source": "/book-online/**",
        "destination": "/formations.html",
        "type": 301
      },
      {
        "source": "/courses/**",
        "destination": "/formations.html",
        "type": 301
      },
      {
        "source": "/copie-de-formation-**",
        "destination": "/formations.html",
        "type": 301
      },
      {
        "source": "/parcours",
        "destination": "/formations.html",
        "type": 301
      },
      {
        "source": "/parcours.html",
        "destination": "/formations.html",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=300,must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|svg|ico|avif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=86400,must-revalidate"
          }
        ]
      },
      {
        "source": "/admin/js/components.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/js/sbi-version.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/admin/css/admin-responsive.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/admin/css/sbi-bottom-nav.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/api/sendSbiContact",
        "function": {
          "functionId": "sendSbiContact",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/requestPasswordReset",
        "function": {
          "functionId": "requestPasswordReset",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/subscribeNewsletter",
        "function": {
          "functionId": "subscribeNewsletter",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/ingestAnalytics",
        "function": {
          "functionId": "ingestAnalytics",
          "region": "europe-west1"
        }
      },
      {
        "source": "/teacher/lives",
        "destination": "/teacher/lives.html"
      },
      {
        "source": "/teacher/lives-v2",
        "destination": "/teacher/lives-v2.html"
      },
      {
        "source": "/teacher/lives-v1",
        "destination": "/teacher/lives-v1.html"
      },
      {
        "source": "/admin/admin-lives",
        "destination": "/admin/admin-lives.html"
      },
      {
        "source": "/admin/admin-lives-v2",
        "destination": "/admin/admin-lives-v2.html"
      },
      {
        "source": "/admin/admin-lives-v1",
        "destination": "/admin/admin-lives-v1.html"
      },
      {
        "source": "/admin/formations-live",
        "destination": "/admin/formations-live.html"
      },
      {
        "source": "/live-room",
        "destination": "/live-room.html"
      },
      {
        "source": "/student/live-replay",
        "destination": "/student/live-replay.html"
      },
      {
        "source": "/live-room/**",
        "destination": "/live-room.html"
      },
      {
        "source": "/student/live-replay/**",
        "destination": "/student/live-replay.html"
      },
      {
        "source": "/student/live-replay.html/**",
        "destination": "/student/live-replay.html"
      },
      {
        "source": "/live-room.html/**",
        "destination": "/live-room.html"
      },
      {
        "source": "/api/liveReplay",
        "function": {
          "functionId": "streamLiveReplay",
          "region": "europe-west1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "public/functions"
  }
}
